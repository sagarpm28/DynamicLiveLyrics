<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_canvas_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_title" />

    <!-- Hotspot zones for COMPACT_STRIP layout: Top (Left 44% Header + Right 56% 6 Buttons), Middle (Lyrics), Bottom (Visual Progress) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100">

        <!-- Top 32%: Left Album Art/Title (44%) + Right 6 Transport Buttons (56%) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="32"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/btn_header_open_app"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="44"
                android:background="@android:color/transparent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="56"
                android:orientation="horizontal"
                android:weightSum="6">

                <FrameLayout
                    android:id="@+id/btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/btn_seek_back"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/btn_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/btn_seek_fwd"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/btn_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/btn_like"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Middle 50%: Live Lyrics Stage (left 82%) + Provider Switch (right 18%) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="50"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/btn_lyrics_stage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="82"
                android:background="@android:color/transparent" />

            <FrameLayout
                android:id="@+id/btn_provider_pill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="18"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Bottom 18%: Wavy Progress Bar (Visual Show Only) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="18"
            android:background="@android:color/transparent" />

    </LinearLayout>

</FrameLayout>
