<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_canvas_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_title" />

    <!-- Hotspot zones for SPLIT_SIDE_BY_SIDE layout: Left 42% (Art + Visual Progress + 6 Buttons), Right 58% (Provider + Lyrics) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="100">

        <!-- Left 42%: Album Art, Title, Wavy Progress Bar (display only), and 6 NKB Transport Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="42"
            android:orientation="vertical"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/btn_header_open_app"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="58"
                android:background="@android:color/transparent" />

            <!-- Progress Bar Row (16%): Visual Show Only -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="16"
                android:background="@android:color/transparent" />

            <!-- Bottom 26%: 6 NKB Transport Buttons (Prev | -5s | Play/Pause | +5s | Next | Like) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="26"
                android:orientation="horizontal"
                android:weightSum="6">

                <FrameLayout
                    android:id="@+id/btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/btn_seek_back"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/btn_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/btn_seek_fwd"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/btn_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />

                <FrameLayout
                    android:id="@+id/btn_like"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent" />
            </LinearLayout>

        </LinearLayout>

        <!-- Right 58%: Provider Switcher Pill at top + Large Live Lyrics Stage -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="58"
            android:orientation="vertical"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/btn_provider_pill"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="15"
                android:background="@android:color/transparent" />

            <FrameLayout
                android:id="@+id/btn_lyrics_stage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="85"
                android:background="@android:color/transparent" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
